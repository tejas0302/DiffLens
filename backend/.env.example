# Copy to .env and fill in. NEVER commit .env.
GITHUB_APP_ID=123456
# Paste the .pem contents on ONE line, with each newline written as \n
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=pick-a-long-random-string
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Leave unset locally to use SQLite. In production, paste your Neon/Supabase Postgres URL.
# DATABASE_URL=postgresql://user:pass@host/db
FRONTEND_URL=http://localhost:3000
MAX_CHANGED_LINES=2000
